 "phases": [
  {
   "id": 1,
   "name": {
    "nl": "Zwaar trekken en leren hangen"
   },
   "expectedWeeks": [
    1,
    10
   ],
   "templates": {
    "A": "A1",
    "B": "B1",
    "C": "C1",
    "TEST": "T1"
   },
   "exitGate": {
    "source": "validTestDay",
    "window": "sameTestDay",
    "all": [
     "t.wpu_e1rm_added >= p.thresholdRatio * t.bw - p.gate1GapKg",
     "min(t.oa_hang_s.L, t.oa_hang_s.R) >= 20",
     "t.oa_neg5_unassisted.L && t.oa_neg5_unassisted.R",
     "min(t.oa_top_hold_s.L, t.oa_top_hold_s.R) >= 8"
    ]
   }
  },
  {
   "id": 2,
   "name": {
    "nl": "Assistentie afbouwen"
   },
   "expectedWeeks": [
    11,
    25
   ],
   "templates": {
    "A": "A2",
    "B": "B1",
    "C": "C2",
    "TEST": "T2"
   },
   "exitGate": {
    "source": "validTestDay",
    "window": "sameTestDay",
    "all": [
     "t.wpu_e1rm_added >= p.thresholdRatio * t.bw",
     "min(t.oa_top_hold_s.L, t.oa_top_hold_s.R) >= 15",
     "t.oa_neg5_unassisted.L && t.oa_neg5_unassisted.R",
     "t.oa_one_finger_rep.L && t.oa_one_finger_rep.R"
    ]
   }
  },
  {
