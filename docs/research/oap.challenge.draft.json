{
 "schema": "fitapp.challenge/1",
 "id": "oap",
 "version": "1.0.0",
 "engine": ">=1.0.0 <2.0.0",
 "title": {
  "en": "One-arm pull-up",
  "nl": "Van twaalf naar één"
 },
 "summary": {
  "en": "Strict one-arm pull-up: heavy weighted pulling + parallel unilateral skill work; criteria-gated phases; 5-week blocks (4 build + 1 deload/test)."
 },
 "provenance": {
  "source": "claude.ai artifact B56eCk6wQMfAgSXBTCwmpW, updated 2026-10-07",
  "evidence": "threshold 65-75% BW and hang/hold gates are coach heuristics (Kavadlo, StrongFirst forum, Willoughby), not research",
  "tagLegend": {
   "A": "taken from artifact",
   "P": "proposed by app design, needs user approval"
  }
 },
 "challengeRules": {
  "start": "dead_hang_full_extension",
  "implement": [
   "bar",
   "fixed_handle"
  ],
  "forbidden": [
   "free_hanging_ring",
   "free_hand_contact",
   "kip"
  ],
  "finish": "chin_over_bar",
  "return": "controlled_to_full_extension",
  "agreedWithOpponentOn": "2026-08-31"
 },
 "params": {
  "grip": {
   "type": "enum",
   "values": [
    "supinated",
    "neutral",
    "pronated"
   ],
   "default": "supinated",
   "tag": "A"
  },
  "completionArms": {
   "type": "enum",
   "values": [
    "any",
    "both"
   ],
   "default": "any",
   "tag": "P"
  },
  "thresholdRatio": {
   "type": "number",
   "default": 0.65,
   "min": 0.55,
   "max": 0.85,
   "byGrip": {
    "supinated": 0.65,
    "neutral": 0.7,
    "pronated": 0.75
   },
   "tag": "A",
   "note": "neutral/pronated ratios unsourced interpolations"
  },
  "gate1GapKg": {
   "type": "mass",
   "default": 2.0,
   "tag": "A",
   "note": "0.65*70.7-2.0 = 43.96 ~ +44"
  },
  "testStrengthMode": {
   "type": "enum",
   "values": [
    "3RM",
    "1RM",
    "both"
   ],
   "default": "3RM",
   "tag": "A"
  },
  "e1rmMethod": {
   "type": "enum",
   "values": [
    "multiplier3RM",
    "personalCurve"
   ],
   "default": "multiplier3RM",
   "tag": "A"
  },
  "m3": {
   "type": "number",
   "default": 1.1,
   "min": 1.03,
   "max": 1.14,
   "tag": "A",
   "note": "(BW+3RM)*1.10-BW"
  },
  "curveK0": {
   "type": "number",
   "default": 30,
   "min": 20,
   "max": 45,
   "tag": "P"
  },
  "anchorLoad": {
   "type": "mass",
   "default": 20.0,
   "tag": "A"
  },
  "anchorReps": {
   "type": "int",
   "default": 5,
   "tag": "A"
  },
  "kgPerRep": {
   "type": "mass",
   "default": 2.17,
   "tag": "A"
  },
  "anchorFraction": {
   "type": "number",
   "default": "onboard: (bw + anchorLoad) / (bw + e1rmAdded)",
   "tag": "P",
   "note": "(70.7+20)/(70.7+42.8)=0.799"
  },
  "negFraction": {
   "type": "number",
   "default": 1.05,
   "tag": "A"
  },
  "negResetStep": {
   "type": "mass",
   "default": 2.5,
   "tag": "A",
   "note": "artifact: reset to 45 kg = 47.5-2.5"
  },
  "pinA0": {
   "type": "pin",
   "default": 40,
   "tag": "A"
  },
  "pinC0": {
   "type": "pin",
   "default": 50,
   "tag": "A"
  },
  "pinHold90_0": {
   "type": "pin",
   "default": 35,
   "tag": "A"
  },
  "pinOffsetA": {
   "type": "pin",
   "default": 10,
   "tag": "P",
   "note": "pinA after test = weaker-arm least-assist pin + 10 lb"
  },
  "pinOffsetC": {
   "type": "pin",
   "default": 10,
   "tag": "P",
   "note": "pinC = pinA + 10 (matches 40/50)"
  },
  "pinOffsetHold90": {
   "type": "pin",
   "default": -5,
   "tag": "P",
   "note": "pinHold90 = pinA - 5 (matches 40/35)"
  },
  "gatePinDecreaseA": {
   "type": "bool",
   "default": true,
   "tag": "P",
   "note": "artifact: -5 lb every week unconditionally"
  },
  "minGymSessionsForWeek": {
   "type": "int",
   "default": 2,
   "tag": "P"
  },
  "maxRecalcJumpKg": {
   "type": "mass",
   "default": 5.0,
   "tag": "P"
  },
  "progressEps": {
   "type": "object",
   "default": {
    "e1rmKg": 1.0,
    "hangS": 2,
    "topHoldS": 1,
    "assistLb": 5
   },
   "tag": "P"
  },
  "injuryDays": {
   "type": "int",
   "default": 14,
   "tag": "A"
  },
  "painFreeDaysToExit": {
   "type": "int",
   "default": 3,
   "tag": "P"
  },
  "maxHeavyUnilateralPerWeek": {
   "type": "int",
   "default": 3,
   "tag": "A"
  },
  "ladderCount": {
   "type": "int",
   "default": 3,
   "tag": "P"
  }
 },
