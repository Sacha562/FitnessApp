 "state": {
  "vars": {
   "e1rmAdded": {
    "type": "mass",
    "init": "onboard.e1rmAdded"
   },
   "m3": {
    "type": "number",
    "init": "p.m3"
   },
   "curveK": {
    "type": "number",
    "init": "p.curveK0"
   },
   "kgPerRep": {
    "type": "mass",
    "init": "p.kgPerRep"
   },
   "wpuC": {
    "type": "mass",
    "init": "p.anchorLoad"
   },
   "wpuA": {
    "type": "mass",
    "init": "roundLoad(p.anchorLoad + 1 * p.kgPerRep, 'belt', 'nearest')"
   },
   "wpuB": {
    "type": "mass",
    "init": "onboard.wpuB ?? roundLoad(p.anchorLoad + 3 * p.kgPerRep, 'belt', 'nearest')"
   },
   "negB": {
    "type": "mass",
    "init": "roundLoad(p.negFraction * (bw + s.e1rmAdded) - bw, 'belt', 'down')"
   },
   "negReset": {
    "type": "mass",
    "init": "s.negB - p.negResetStep"
   },
   "pinA": {
    "type": "pin",
    "init": "p.pinA0"
   },
   "pinC": {
    "type": "pin",
    "init": "p.pinC0"
   },
   "pinHold90": {
    "type": "pin",
    "init": "p.pinHold90_0"
   },
   "fingerLevel": {
    "type": "int",
    "init": "4"
   },
   "plankS": {
    "type": "duration",
    "init": "20"
   },
   "oaHangS": {
    "type": "duration",
    "init": "10"
   },
