    null
   ],
   "templates": {
    "A": "A3",
    "B": "B3",
    "C": "C3",
    "TEST": "T2"
   },
   "exitGate": {
    "source": "validTestDayOrSessionAttempt",
    "all": [
     "p.completionArms == 'any' ? (t.oa_rep.L || t.oa_rep.R) : (t.oa_rep.L && t.oa_rep.R)"
    ]
   },
   "onExit": "complete"
  }
 ],
