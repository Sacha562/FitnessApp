 },
 "rules": [
  {
   "id": "safety.elbow.stop",
   "stage": "safety",
   "prio": 100,
   "on": [
    "pain.reported"
   ],
   "if": "event.kind in ['medial_elbow_ache', 'elbow_crease_pain_on_extension', 'ulnar_tingling']",
   "then": [
    {
     "enterMode": "injury"
    },
    {
     "set": "s.injuryStart",
     "to": "today"
    },
    {
     "set": "s.needsCleanSession",
     "to": "true"
    },
    {
     "notify": "stop",
     "msg": "elbow_protocol"
    }
   ],
   "tag": "A"
  },
  {
   "id": "safety.elbow.trace",
   "stage": "safety",
   "prio": 95,
   "on": [
    "readiness.checked"
   ],
   "if": "true",
   "then": [
    {
     "set": "s.elbowTrace",
     "to": "event.elbowDiscomfort >= 1"
    }
   ],
   "tag": "A"
  },
  {
   "id": "safety.injury.exit",
   "stage": "safety",
   "prio": 90,
   "on": [
    "day.tick"
   ],
   "if": "mode == 'injury' && daysSince(s.injuryStart) >= p.injuryDays && daysSincePain() >= p.painFreeDaysToExit",
   "then": [
    {
     "restoreSnapshot": "max(1, block.index - 2)"
    },
    {
     "setMode": "normal"
    },
    {
     "startNewBlock": true
    },
    {
     "notify": "info",
     "msg": "back_to_level_two_blocks_ago"
    }
   ],
   "tag": "A"
  },
  {
   "id": "safety.injury.extend",
   "stage": "safety",
   "prio": 89,
   "on": [
    "day.tick"
   ],
   "if": "mode == 'injury' && daysSince(s.injuryStart) >= p.injuryDays && daysSincePain() < p.painFreeDaysToExit",
   "then": [
    {
     "set": "s.injuryStart",
     "to": "today - p.injuryDays + 7"
    },
    {
     "notify": "warn",
     "msg": "pain_persists_consider_physio"
    }
   ],
   "tag": "P"
  },
  {
   "id": "data.test.recalc",
   "stage": "data",
   "prio": 80,
   "on": [
    "test.completed"
   ],
   "if": "test.valid",
   "then": [
    {
     "call": "oapRecalcFromTest"
    }
   ],
   "tag": "A"
  },
  {
   "id": "guard.gripSlip",
   "stage": "progression",
   "prio": 60,
   "on": [
    "session.completed"
   ],
   "if": "sess.template in ['A', 'B', 'C'] && any(ex.wpu.gripSlipBeforeLast)",
   "then": [
    {
     "lock": [
      "s.wpuA",
      "s.wpuB",
      "s.wpuC"
     ],
     "kind": "noIncrease"
    },
    {
     "notify": "info",
     "msg": "grip_not_strength"
    }
   ],
   "tag": "A"
  },
  {
   "id": "prog.B.wpu",
   "stage": "progression",
   "prio": 50,
   "on": [
    "session.completed"
   ],
   "if": "sess.template == 'B' && s.bVariant == '6x2' && valid('wpu') && count(ex.wpu.sets) >= 6 && all(ex.wpu.reps >= 2) && min(ex.wpu.rir) >= 2",
   "then": [
    {
     "adjust": "s.wpuB",
     "by": "2.5",
     "round": [
      "belt",
      "nearest"
     ]
    }
   ],
   "tag": "A"
  },
  {
   "id": "prog.B.neg.up",
   "stage": "progression",
   "prio": 50,
   "on": [
    "session.completed"
   ],
   "if": "sess.template == 'B' && valid('neg') && min(ex.neg.ecc_s) >= 8 && !any(ex.neg.jerky)",
   "then": [
    {
     "adjust": "s.negB",
     "by": "5",
     "round": [
      "belt",
      "down"
     ]
    },
    {
     "adjust": "s.negReset",
     "by": "5",
     "round": [
      "belt",
      "down"
     ]
    }
   ],
   "tag": "A"
  },
  {
   "id": "prog.B.neg.reset",
   "stage": "progression",
   "prio": 50,
   "on": [
    "session.completed"
   ],
   "if": "sess.template == 'B' && valid('neg') && (min(ex.neg.ecc_s) < 5 || any(ex.neg.jerky))",
   "then": [
    {
     "set": "s.negB",
     "to": "s.negReset"
    }
   ],
   "tag": "A"
  },
  {
   "id": "prog.A.pin",
   "stage": "progression",
   "prio": 50,
   "on": [
    "session.completed"
   ],
   "if": "sess.template == 'A' && valid('oaa') && (!p.gatePinDecreaseA || all(ex.oaa.reps >= 3))",
   "then": [
    {
     "set": "s.pinA",
     "to": "max(0, s.pinA - 5)"
    },
    {
     "set": "s.aFailStreak",
     "to": "0"
    }
   ],
   "tag": "A+P"
  },
  {
   "id": "prog.A.pin.fail",
   "stage": "progression",
   "prio": 50,
   "on": [
    "session.completed"
   ],
   "if": "sess.template == 'A' && p.gatePinDecreaseA && valid('oaa') && any(ex.oaa.reps < 3)",
   "then": [
    {
     "set": "s.aFailStreak",
     "to": "s.aFailStreak + 1 >= 2 ? 0 : s.aFailStreak + 1"
    },
    {
     "set": "s.pinA",
     "to": "s.aFailStreak + 1 >= 2 ? s.pinA + 5 : s.pinA"
    }
   ],
   "tag": "P"
  },
  {
   "id": "prog.A.hold90",
   "stage": "progression",
   "prio": 50,
   "on": [
    "session.completed"
   ],
   "if": "sess.template == 'A' && valid('h90')",
   "then": [
    {
     "set": "s.pinHold90",
     "to": "any(ex.h90.hold_s < 6) ? s.pinHold90 + 5 : max(0, s.pinHold90 - 5)"
    }
   ],
   "tag": "A"
  },
  {
   "id": "prog.C.pin",
   "stage": "progression",
   "prio": 50,
   "on": [
    "session.completed"
   ],
   "if": "sess.template == 'C' && valid('oaa')",
   "let": {
    "easy": "all(ex.oaa.reps >= 5) && (min(ex.oaa.rir) >= 3 || reasonOn('oaa') == 'too_easy')"
   },
   "then": [
    {
     "set": "s.pinC",
     "to": "easy && s.cEasyStreak + 1 >= 2 ? max(0, s.pinC - 5) : s.pinC"
    },
    {
     "set": "s.cEasyStreak",
     "to": "easy ? (s.cEasyStreak + 1 >= 2 ? 0 : s.cEasyStreak + 1) : 0"
    }
   ],
   "tag": "A"
  },
  {
   "id": "prog.plank",
   "stage": "progression",
   "prio": 50,
   "on": [
    "session.completed",
    "habit.completed"
   ],
   "if": "valid('plank') && count(ex.plank.sets) >= 6 && all(ex.plank.hold_s >= s.plankS) && !any(ex.plank.hipRotation) && s.plankS < 30",
   "then": [
    {
     "set": "s.plankS",
     "to": "30"
    }
   ],
   "tag": "A"
  },
  {
   "id": "prog.finger",
   "stage": "progression",
   "prio": 50,
   "on": [
    "session.completed"
   ],
   "if": "phase == 2 && sess.template == 'A' && s.pinA == 0 && valid('oaa') && all(ex.oaa.reps >= 3)",
   "then": [
    {
     "set": "s.fingerLevel",
     "to": "max(1, s.fingerLevel - 1)"
    }
   ],
   "tag": "P"
  },
  {
   "id": "struct.cleanSession",
   "stage": "structural",
   "prio": 40,
   "on": [
    "session.completed"
   ],
   "if": "sess.template in ['A', 'B', 'C'] && mode != 'injury' && !sess.painReported && sess.completionRatio >= 0.8",
   "then": [
    {
     "set": "s.needsCleanSession",
     "to": "false"
    }
   ],
   "tag": "A"
  },
  {
   "id": "struct.week.close",
   "stage": "structural",
   "prio": 30,
   "on": [
    "week.closed"
   ],
   "if": "mode != 'injury'",
   "then": [
    {
     "if": "week.gymSessionsDone >= p.minGymSessionsForWeek",
     "do": [
      {
       "advanceWeek": true
      }
     ],
     "else": [
      {
       "repeatWeek": true
      },
      {
       "set": "s.needsCleanSession",
       "to": "true"
      },
      {
       "notify": "info",
       "msg": "missed_week_no_makeup"
      }
     ]
    }
   ],
   "tag": "A+P"
  },
  {
   "id": "struct.deload.enter",
   "stage": "structural",
   "prio": 30,
   "on": [
    "week.started"
   ],
   "if": "block.week == 5 && mode == 'normal'",
   "then": [
    {
     "setMode": "deload"
    },
    {
     "scheduleTest": "schedule.testDay"
    }
   ],
   "tag": "A"
  },
  {
   "id": "struct.test.postpone",
   "stage": "structural",
   "prio": 30,
   "on": [
    "test.due"
   ],
   "if": "s.needsCleanSession",
   "then": [
    {
     "setMode": "test_pending"
    },
    {
     "postponeTest": "schedule.testDay.postponeTo"
    },
    {
     "notify": "info",
     "msg": "test_postponed_until_clean_session"
    }
   ],
   "tag": "A"
  },
  {
   "id": "struct.stall",
   "stage": "structural",
   "prio": 20,
   "on": [
    "test.completed"
   ],
   "if": "test.valid && prevTest.exists",
   "let": {
    "progress": "t.wpu_e1rm_added - pt.wpu_e1rm_added >= p.progressEps.e1rmKg || min(t.oa_hang_s.L, t.oa_hang_s.R) - min(pt.oa_hang_s.L, pt.oa_hang_s.R) >= p.progressEps.hangS || min(t.oa_top_hold_s.L, t.oa_top_hold_s.R) - min(pt.oa_top_hold_s.L, pt.oa_top_hold_s.R) >= p.progressEps.topHoldS || max(pt.oa_least_assist_pin.L, pt.oa_least_assist_pin.R) - max(t.oa_least_assist_pin.L, t.oa_least_assist_pin.R) >= p.progressEps.assistLb"
   },
   "then": [
    {
     "set": "s.noProgressTests",
     "to": "progress ? 0 : s.noProgressTests + 1"
    },
    {
     "set": "s.stallStage",
     "to": "progress ? 0 : (s.noProgressTests + 1 >= 2 && s.stallStage == 0 ? 1 : (s.noProgressTests + 1 >= 3 && s.stallStage == 1 ? 2 : s.stallStage))"
    },
    {
     "set": "s.bVariant",
     "to": "!progress && s.noProgressTests + 1 >= 3 && s.stallStage == 1 ? 'ladder123' : s.bVariant"
    },
    {
     "set": "s.extraDeloadPending",
     "to": "!progress && s.noProgressTests + 1 >= 3 && s.stallStage == 1"
    }
   ],
   "tag": "A+P"
  },
  {
   "id": "struct.phase.gate",
   "stage": "structural",
   "prio": 15,
   "on": [
    "test.completed",
    "attempt.logged"
   ],
   "if": "phaseGatePasses(phase)",
   "then": [
    {
     "advancePhase": true
    },
    {
     "notify": "celebrate",
     "msg": "phase_up"
    }
   ],
   "tag": "A"
  },
  {
   "id": "struct.block.next",
   "stage": "structural",
   "prio": 10,
   "on": [
    "test.completed"
   ],
   "if": "test.valid",
   "then": [
    {
     "startNewBlock": true
    },
    {
     "if": "s.extraDeloadPending",
     "do": [
      {
       "insertWeek": "extra_deload"
      },
      {
       "set": "s.extraDeloadPending",
       "to": "false"
      }
     ]
    }
   ],
   "tag": "A"
  }
 ],
 "inSessionRules": [
  {
   "id": "upd.wpu.gripStop",
   "item": "wpu",
   "on": "set.logged",
   "if": "set.gripSlipBeforeLast",
   "then": "endSet; markNoIncrease",
   "tag": "A"
  },
  {
   "id": "upd.h90.fail",
   "item": "h90",
   "on": "set.logged",
   "if": "set.hold_s < 6",
   "then": "remainingSets.assistPin += 5",
   "tag": "A"
  },
  {
   "id": "upd.oaa.fail",
   "item": "oaa",
   "on": "set.logged",
   "if": "set.reps <= set.targetReps - 2",
   "then": "remainingSets.assistPin += 5",
   "tag": "P"
  },
  {
   "id": "upd.B.wpu.grind",
   "item": "wpu",
   "template": "B",
   "on": "set.logged",
   "if": "set.reps < set.targetReps || set.rir == 0",
   "then": "remainingSets.added = roundLoad(added - 2.5, 'belt', 'down')",
   "tag": "P"
  },
  {
   "id": "upd.scap.sideCap",
   "item": "scap",
   "on": "set.logged",
   "if": "set.side == 'L'",
   "then": "nextSet(R).targetReps = min(targetReps, set.reps)",
   "tag": "A"
  }
 ],
 "onboarding": {
  "steps": [
   {
    "id": "rules",
    "fields": [
     "p.grip",
     "p.completionArms"
    ]
   },
   {
    "id": "equipment",
    "fields": [
     "equipment.assisted_pullup_machine.calibration",
     "gym.plates",
     "has('wide_bar')",
     "has('dip_belt')"
    ]
   },
   {
    "id": "baseline",
    "modes": [
     "enterKnown",
     "scheduleBaselineTest"
    ],
    "metrics": [
     "bw",
     "wpu_3rm_added|wpu_1rm_added",
     "bw_max_reps",
     "oa_hang_s",
     "oa_top_hold_s",
     "oa_least_assist_pin"
    ]
   },
   {
    "id": "importHistory",
    "optional": true,
    "fields": [
     "pastTests[] (validForGate flag)",
     "currentLoads",
     "phase",
     "block.index",
     "block.week",
     "mode",
     "plannedTestDate"
    ]
   },
   {
    "id": "schedule",
    "fields": [
     "schedule.preferred",
     "habits.time"
    ]
   },
   {
    "id": "review",
    "shows": [
     "first 2 weeks materialized",
     "all P-tagged rules (accept/decline each)",
     "warnings"
    ]
   }
  ]
 }
}